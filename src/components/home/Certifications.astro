---
import IconComponent from '../atoms/IconComponent.jsx';

const certifications = [
  {
    id: 'cert-1',
    name: 'Introduction to Kubernetes',
    issuer: 'The Linux Foundation',
    date: '2025',
    badge: true,
    description: 'Official certified and evaluated course by The Linux Foundation demonstrating comprehensive understanding of Kubernetes fundamentals, container orchestration, and cloud-native technologies.',
    icon: 'logos:kubernetes',
    skills: ['Kubernetes Fundamentals', 'Container Orchestration', 'Cloud-Native Technologies', 'Pod Management', 'Services & Networking'],
    certificateUrl: 'https://ti-user-certificates.s3.amazonaws.com/e0df7fbf-a057-42af-8a1f-590912be5460/0c0cf1ac-6d97-476c-a294-2cc068b44a94-belfor-acua-ad566f2d-f2c4-4f19-a0c7-11c5a15a1c44-certificate.pdf',
    credlyBadgeId: 'b6f48d73-8034-4991-8d09-fc2484b02d5b'
  }
];

const achievements = [
  {
    id: 'achievement-1',
    name: 'Multi-Environment Kubernetes Migration',
    description: 'Successfully migrated deployments from Docker Compose + Nginx to Kubernetes (k3s) across three environments (dev, preprod, prod) using Helm charts, ConfigMaps, and Kubeseal for secure secret management.',
    icon: 'logos:kubernetes',
    category: 'Infrastructure'
  },
  {
    id: 'achievement-2',
    name: 'GitOps Implementation with ArgoCD',
    description: 'Developed comprehensive CI/CD pipelines with GitHub Actions and GitLab CI featuring environment-based versioning, automatic Docker image publication, and continuous deployment using ArgoCD for synchronized environments.',
    icon: 'logos:argo-icon',
    category: 'DevOps'
  },
  {
    id: 'achievement-3',
    name: 'Critical Production Incident Resolution',
    description: 'Led identification and resolution of critical production incidents including PostgreSQL data corruption and service failures, establishing recovery procedures and DevOps-Development communication workflows.',
    icon: 'logos:postgresql',
    category: 'SRE'
  },
  {
    id: 'achievement-4',
    name: 'Infrastructure Automation & Security',
    description: 'Implemented VPS-based infrastructure with Traefik load balancing, self-signed TLS certificates and DNS management on Cloudflare/GoDaddy.',
    icon: 'logos:traefik',
    category: 'Automation'
  }
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-12 sm:gap-16">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Certifications & Achievements</h2>
      
      <!-- Certifications Section -->
      <div class="flex flex-col gap-8">
        <h3 class="text-2xl font-medium tracking-tight">Certifications</h3>
        <div class="grid gap-6 lg:grid-cols-1">
          {certifications.map((cert) => (
            <div class="bg-primary-500/10 dark:bg-primary-400/10 flex flex-col gap-6 rounded-3xl px-6 py-8">
              <div class="flex flex-col lg:flex-row items-start gap-6">
                <div class="flex-shrink-0">
                  <IconComponent icon={cert.icon} client:load />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h4 class="text-xl font-medium">{cert.name}</h4>
                    {cert.badge && (
                      <span class="bg-primary-600 dark:bg-primary-400 text-white dark:text-primary-950 px-3 py-1 rounded-full text-sm font-medium">
                        Certified
                      </span>
                    )}
                  </div>
                  <p class="text-primary-600 dark:text-primary-400 font-medium mb-2">
                    {cert.issuer} • {cert.date}
                  </p>
                  <p class="text-primary-950/70 dark:text-primary-200/70 text-base mb-4">
                    {cert.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {cert.skills.map((skill) => (
                      <span class="bg-primary-100 dark:bg-primary-800 text-primary-800 dark:text-primary-200 px-3 py-1 rounded-full text-sm">
                        {skill}
                      </span>
                    ))}
                  </div>
                  {cert.certificateUrl && (
                    <div class="flex gap-3 mb-4">
                      <a
                        href={cert.certificateUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="bg-primary-600 dark:bg-primary-400 hover:bg-primary-700 dark:hover:bg-primary-300 text-white dark:text-primary-950 px-4 py-2 rounded-lg text-sm font-medium transition inline-flex items-center gap-2"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        View Certificate
                      </a>
                    </div>
                  )}
                </div>
                {cert.credlyBadgeId && (
                  <div class="flex-shrink-0 hidden dark:hidden lg:block">
                    <div class="credly-badge-container">
                      <div
                        data-iframe-width="150"
                        data-iframe-height="270"
                        data-share-badge-id={cert.credlyBadgeId}
                        data-share-badge-host="https://www.credly.com"
                      ></div>
                    </div>
                  </div>
                )}
                {cert.credlyBadgeId && (
                  <div class="flex-shrink-0 lg:hidden">
                    <a
                      href={`https://www.credly.com/badges/${cert.credlyBadgeId}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition inline-flex items-center gap-2"
                    >
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                      </svg>
                      View on Credly
                    </a>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Achievements Section -->
      <div class="flex flex-col gap-8">
        <h3 class="text-2xl font-medium tracking-tight">Key Achievements</h3>
        <div class="grid gap-6 lg:grid-cols-2">
          {achievements.map((achievement) => (
            <div class="bg-primary-500/10 dark:bg-primary-400/10 flex flex-col gap-4 rounded-3xl px-6 py-8">
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0">
                  <IconComponent icon={achievement.icon} client:load />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h4 class="text-lg font-medium">{achievement.name}</h4>
                    <span class="bg-primary-200 dark:bg-primary-700 text-primary-800 dark:text-primary-200 px-2 py-1 rounded text-xs font-medium">
                      {achievement.category}
                    </span>
                  </div>
                  <p class="text-primary-950/70 dark:text-primary-200/70 text-base">
                    {achievement.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .credly-badge-container {
    border-radius: 12px;
    overflow: hidden;
    background: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    padding: 8px;
  }

  .credly-badge-container iframe {
    border-radius: 8px;
    background: white !important;
  }
</style>

<script type="text/javascript" async src="//cdn.credly.com/assets/utilities/embed.js"></script>
