---
import IconComponent from '../atoms/IconComponent.jsx';

const features = [
  {
    id: 'expertise-1',
    name: 'Container Orchestration & Kubernetes',
    icons: [
      { name: 'Kubernetes', icon: 'logos:kubernetes' },
      { name: 'Docker', icon: 'logos:docker-icon' },
      { name: 'Helm', icon: 'logos:helm' },
    ],
    description:
      'Expert in Kubernetes (k3s bare-metal) cluster management and container orchestration. Specialized in managing multi-environment deployments (dev, preprod, prod) with Helm charts, ConfigMaps, Kubeseal for secrets management, and persistent volumes. Hands-on experience with self-signed TLS certificates and production-grade Kubernetes infrastructure.',
  },

  {
    id: 'expertise-2',
    name: 'CI/CD & GitOps',
    icons: [
      { name: 'ArgoCD', icon: 'logos:argo-icon' },
      { name: 'GitLab CI', icon: 'logos:gitlab' },
      { name: 'GitHub Actions', icon: 'logos:github-actions' },
      { name: 'Bash', icon: 'logos:bash-icon' },
    ],
    description:
      'Proficient in GitOps workflows using ArgoCD for continuous deployment and environment synchronization. Expert in building CI/CD pipelines with GitLab CI/CD and GitHub Actions, including environment-based versioning, automated Docker image publication, and semantic release workflows. Strong Bash scripting skills for automation.',
  },
  {
    id: 'expertise-3',
    name: 'Infrastructure & Networking',
    icons: [
      { name: 'Traefik', icon: 'logos:traefik' },
      { name: 'Nginx', icon: 'logos:nginx' },
      { name: 'Cloudflare', icon: 'devicon:cloudflare' },
      { name: 'Linux', icon: 'logos:linux-tux' },
    ],
    description:
      'Experienced in VPS-based infrastructure management with Traefik and Nginx as reverse proxies and load balancers. Skilled in DNS management (Cloudflare/GoDaddy), UFW firewall configuration, TLS/SSL setup, and self-hosted mail server with Mailcow. Linux Foundation certified with strong Ubuntu, Arch, and Debian administration skills.',
  },
  {
    id: 'expertise-4',
    name: 'Monitoring & Incident Response',
    icons: [
      { name: 'ArgoCD', icon: 'logos:argo-icon' },
      { name: 'Prometheus', icon: 'logos:prometheus' },
      { name: 'Grafana', icon: 'logos:grafana' },
      { name: 'PostgreSQL', icon: 'logos:postgresql' },
    ],
    description:
      'Experienced in production incident management including PostgreSQL data corruption recovery, service failure resolution, and rollback procedures. Currently implementing Prometheus and Grafana for comprehensive monitoring. Strong focus on system reliability, documentation of recovery procedures, and DevOps-Development communication workflows.',
  },
  {
    id: 'expertise-5',
    name: 'Backend Development & APIs',
    icons: [
      { name: 'NestJS', icon: 'logos:nestjs' },
      { name: 'Spring Boot', icon: 'simple-icons:springboot' },
      { name: 'Express', icon: 'skill-icons:expressjs-dark' },
      { name: 'MongoDB', icon: 'logos:mongodb-icon' },
    ],
    description:
      'Strong foundation in backend development supporting DevOps initiatives. Experienced in building RESTful APIs with NestJS, Express, and Spring Boot. Proficient in database management with PostgreSQL and MongoDB, with focus on scalable architectures that support containerized deployments and microservices.',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-8">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Skills</h2>
      <div class="lg:col-span-2">
        <dl
          class="-mt-3"
          x-data="{ selected: null, toggle(value) { this.selected = this.selected === value ? null : value } }"
        >
          {
            features.map((feature, index) => (
              <div
                class="rounded-3xl px-4 transition"
                x-data={`{ id: ${index}, get isOpen() { return this.id === this.selected }, get isNextOpen() { return (this.id + 1) === this.selected } }`}
                x-bind:class="{ 'bg-primary-500/10 dark:bg-primary-400/10': isOpen }"
              >
                <dt
                  class="border-b text-lg transition"
                  x-cloak
                  x-bind:class="{ 'border-transparent': isOpen || isNextOpen, 'border-primary-900/10 dark:border-primary-300/10': !(isOpen || isNextOpen) }"
                >
                  <button
                    type="button"
                    class="group block w-full py-6 text-left transition focus-visible:outline-none"
                    aria-controls={feature.id}
                    x-on:click="toggle(id)"
                    aria-expanded="false"
                    x-bind:aria-expanded="isOpen.toString()"
                  >
                    <div class="flex items-center justify-between rounded-3xl group-focus-visible:outline group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-primary-950 dark:group-focus-visible:outline-primary-200">
                      <div class="flex gap-x-6 items-center">
                        <span class="font-medium">{feature.name}</span>
                      <div class="flex items-center justify-between gap-x-4">
                        {feature.icons.map((icon) => (
                          <IconComponent icon={icon.icon} client:load />
                        ))}
                      </div>
                      </div>
                      <span class="ml-6 flex h-7 items-center">
                        <svg
                          class="h-6 w-6 rotate-0 transform text-primary-600 transition duration-200 ease-in-out dark:text-primary-400"
                          x-bind:class="{ '-rotate-180': isOpen, 'rotate-0': !isOpen }"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M11.9997 13.1714L16.9495 8.22168L18.3637 9.63589L11.9997 15.9999L5.63574 9.63589L7.04996 8.22168L11.9997 13.1714Z" />
                        </svg>
                      </span>
                    </div>
                  </button>
                </dt>
                <dd class="pb-6 pr-6" id={feature.id} x-show="isOpen" x-cloak x-collapse>
                  <p class=" text-base text-primary-950/70 dark:text-primary-200/70">
                    {feature.description}
                  </p>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
